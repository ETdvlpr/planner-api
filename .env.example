# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
API_PREFIX=api/v1
API_URL=http://localhost:3100
ENABLE_SWAGGER=true
# Comma-separated. Exact origins, or patterns where `*` stands for one or more
# host labels (for Vercel preview deployments, minted per branch). In
# production: the web client's origin, its preview pattern, and localhost for
# developing the web client against the deployed API.
CORS_ORIGIN=http://localhost:3000
# Number of proxy hops to trust. 1 behind nginx; rate limiting is meaningless
# if this is wrong, because every request looks like it came from the proxy.
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://planner:password@localhost:5432/planner?schema=public
# Postgres on the shared box sits at ~26 of 100 connections before Planner
# exists. Keep this small; the API is not connection-bound.
DATABASE_POOL_SIZE=5

# ── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ── Firebase ─────────────────────────────────────────────────────────────────
# Verification needs only the project id. Deleting a Firebase user during
# account erasure needs real service-account credentials — without them, GDPR
# erasure fails half-way and the account stays sign-in-able.
FIREBASE_PROJECT_ID=planner-xxxxx
# Either a path to the service-account JSON…
FIREBASE_SERVICE_ACCOUNT_PATH=
# …or the two fields inline. Escape newlines in the key as \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Object storage (Cloudflare R2) ───────────────────────────────────────────
# Leave blank in development: the media endpoints return 503 and everything
# else works.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=planner-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Optional public base URL if the bucket is fronted by a custom domain.
STORAGE_PUBLIC_BASE_URL=
STORAGE_UPLOAD_URL_TTL=900
STORAGE_DOWNLOAD_URL_TTL=3600
STORAGE_MAX_UPLOAD_BYTES=26214400

# ── Sync ─────────────────────────────────────────────────────────────────────
SYNC_MAX_PUSH_CHANGES=500
SYNC_MAX_PULL_ROWS=500

# ── Backups (read by deploy/planner-backup.sh) ───────────────────────────────
PLANNER_DB_NAME=planner
BACKUP_BUCKET=planner-backups
BACKUP_PREFIX=backups/planner
BACKUP_RETAIN_DAYS=14
